# Backend Environment Variables
# Copy this file to .env and update values

# JWT Secret Key (min 32 chars — change in production!)
SECRET_KEY=boutiquely-ai-super-secret-key-change-in-production-min-32-chars

# JWT Algorithm
ALGORITHM=HS256

# Token expiry in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database URL
# SQLite (default for local dev):
DATABASE_URL=sqlite:///./boutiquely_ai.db

# PostgreSQL (for production):
# DATABASE_URL=postgresql://user:password@localhost:5432/boutiquely_ai
